# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python bytecode / build artifacts ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.installed.cfg
pip-wheel-metadata/

# ── Test / type caches ───────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ── Tool outputs ─────────────────────────────────────────────────────────────
# Everything the toolchain writes is generated output and stays out of git.
# `/note_md/` is anchored to the repo root so nested output dirs are not caught.
output/
/note_md/
_pages/
_staging/
*.jsonl

# ── Model weights and large binaries ─────────────────────────────────────────
models/
*.gguf
*.safetensors
*.bin

# ── Documents / scans (this repo is code-only) ───────────────────────────────
*.pdf
*.png
*.jpg
*.jpeg

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~
.idea/
.vscode/