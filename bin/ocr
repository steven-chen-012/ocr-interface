#!/bin/bash
# ocr — 交互式外壳:菜单式选择输入、输出和各项参数。
#
#   ./ocr/bin/ocr                # 进入交互菜单
#   ./ocr/bin/ocr --help         # 查看用法
#
# 本文件解析出的一切路径都基于自身位置(BASH_SOURCE),不写死任何目录:
#   <包目录>/bin/ocr
#     ├─ ./nmd                          ← 负责找解释器的启动器
#     └─ ../scripts/ocr_shell.py       ← 真正的交互程序
#
# 解释器查找顺序与 nmd 完全一致:
#   1. $OCR_PYTHON / $OCR_VENV_PYTHON
#   2. <包目录>/.venv/bin/python
#   3. <仓库根>/.venv/bin/python
#   4. PATH 上的 python3
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_DIR="$(cd "$BIN_DIR/.." && pwd)"
SCRIPT="$PKG_DIR/scripts/ocr_shell.py"

if [ ! -f "$SCRIPT" ]; then
  echo "[错误] 找不到交互程序: $SCRIPT" >&2
  exit 1
fi

# 1) 优先用显式指定的解释器
PY="${OCR_PYTHON:-${OCR_VENV_PYTHON:-}}"
if [ -n "$PY" ] && [ ! -x "$PY" ]; then
  echo "[错误] OCR_PYTHON 指定的解释器不可执行: $PY" >&2
  exit 1
fi

# 2) 其次找项目自带的 venv(不假设 .venv 一定存在)
if [ -z "$PY" ]; then
  for candidate in "$PKG_DIR/.venv/bin/python" "$PKG_DIR/../.venv/bin/python"; do
    if [ -x "$candidate" ]; then
      PY="$candidate"
      break
    fi
  done
fi

# 3) 最后退回 PATH 上的 python3
if [ -z "$PY" ]; then
  if command -v python3 >/dev/null 2>&1; then
    PY="$(command -v python3)"
  else
    echo "[错误] 没找到 Python。请先建 venv 并安装依赖,或设置 \$OCR_PYTHON。" >&2
    exit 1
  fi
fi

exec "$PY" "$SCRIPT" "$@"
